APP_NAME="WHMCS Billing Portal"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=database

WHMCS_URL=https://billing.example.com
WHMCS_IDENTIFIER=
WHMCS_SECRET=
