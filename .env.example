APP_NAME="WHMCS Billing Portal"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=database

# Runtime WHMCS, payment gateway, refund, checkout and admin credentials
# are managed from /admin/settings and stored in the database.
# APP_KEY remains environment-level because Laravel uses it for encryption.
