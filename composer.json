{
  "name": "resellnom/whmcs-customer-billing-portal",
  "type": "project",
  "description": "Laravel Blade customer billing portal powered by WHMCS API.",
  "require": {
    "php": "^8.2",
    "laravel/framework": "^12.0",
    "guzzlehttp/guzzle": "^7.9"
  },
  "require-dev": {
    "fakerphp/faker": "^1.24",
    "laravel/pint": "^1.24",
    "phpunit/phpunit": "^11.5"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    }
  },
  "scripts": {
    "post-autoload-dump": [
      "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump"
    ]
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}